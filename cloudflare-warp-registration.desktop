[Desktop Entry]
Name=Cloudflare WARP (in Podman) Registration Handler
Comment=Forwards WARP SSO callback URIs into the Podman container
Exec=/usr/bin/podman exec warp-zt-proxy warp-cli --accept-tos registration token %u
Type=Application
Terminal=false
NoDisplay=true
MimeType=x-scheme-handler/com.cloudflare.warp;
